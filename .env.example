# Copia este archivo a .env.local y completa los valores.
# La forma más rápida de conseguir la mayoría de estos: conecta las integraciones
# de Neon (Postgres) y Vercel Blob en el proyecto de Vercel, y luego corre
# `vercel env pull .env.local` — eso trae DATABASE_URL, BLOB_READ_WRITE_TOKEN, etc.

# --- Base de datos (Neon Postgres) ---
# db.js también acepta POSTGRES_URL o DATABASE_URL_UNPOOLED como alternativas,
# tal como las genera la integración de Neon — no hace falta definir las tres.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Vercel Blob (imágenes de producto) ---
BLOB_READ_WRITE_TOKEN=

# --- Admin único (sin tabla en la base de datos) ---
ADMIN_EMAIL=admin@example.com
# Generar con: node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH=
# Cualquier string largo y aleatorio, distinto al de CUSTOMER_JWT_SECRET
ADMIN_JWT_SECRET=

# --- Cuentas de cliente ---
CUSTOMER_JWT_SECRET=

# --- Aviso por correo de pedidos nuevos (opcional — sin esto simplemente no se envía) ---
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# --- Solo desarrollo local ---
# Puerto donde escucha la API local (scripts/dev-api.mjs). Por defecto 4000.
API_PORT=4000
